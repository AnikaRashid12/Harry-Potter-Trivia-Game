.MODEL SMALL

.STACK 100H


; DATA SEGMENT

.DATA

; Menu Messages
welcomeMsg DB 0DH,0AH,"=== HARRY POTTER TRIVIA ===",0DH,0AH,"$" 
passmsg  DB 0DH,0AH,"Enter Password (12 chars): $"
adminmsg DB 0DH,0AH,"=== ADMIN MODE ACTIVATED ===$"
menuMsg DB "1. Start Quiz",0DH,0AH,"2. Exit",0DH,0AH,"$"
choiceMsg DB 0DH,0AH,"Your choice: $"

; Easy Level Questions (Yes/No Format)
easyQ1 DB 0DH,0AH,"Harry Potter is a wizard? (y/n)$"
easyQ2 DB 0DH,0AH,"Harry belongs to Gryffindor house? (y/n)$"
easyQ3 DB 0DH,0AH,"Voldemort is the main antagonist? (y/n)$"
easyQ4 DB 0DH,0AH,"Dumbledore was headmaster of Hogwarts? (y/n)$"

easyQuestions DW easyQ1,easyQ2,easyQ3,easyQ4
easyAnswers DW easyA1,easyA2,easyA3,easyA4
easyCount DB 4

; Medium Level Questions (Multiple Choice Format)
medQ1 DB 0DH,0AH,"Which house values bravery? (a)Gryffindor (b)Slytherin (c)Ravenclaw (d)Hufflepuff$"
medQ2 DB 0DH,0AH,"Who is the Potions professor in most books? (a)Snape (b)Hagrid (c)Lupin (d)Sirius$"
medQ3 DB 0DH,0AH,"What is the name of Harrys owl? (a)Crookshanks (b)Scabbers (c)Hedwig (d)Errol$"
medQ4 DB 0DH,0AH,"Which object stores memories? (a)Horcrux (b)Pensieve (c)Wand (d)Broom$"
medQ5 DB 0DH,0AH,"Which spell disarms an opponent? (a)Expelliarmus (b)Avada (c)Lumos (d)Nox$"
medQ6 DB 0DH,0AH,"Which sport is played on broomsticks? (a)Chess (b)Quidditch (c)Gobstones (d)Duelling$"

medQuestions DW medQ1,medQ2,medQ3,medQ4,medQ5,medQ6
