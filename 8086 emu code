hardlabelmsg DB 0DH,0AH,"=== HARD LEVEL ===$"

; Admin view working variables
current_level DB 0
current_index DB 0
admin_mode DB 0
temp_count DB 0
default_hp DB 3           ; Default hp = 3
admin_password DB "admin1234567$"  ; Admin password constant


; CODE SEGMENT


.CODE


; MAIN PROCEDURE


MAIN PROC
    MOV AX,@DATA
    MOV DS,AX

    ;Admin authentication at startup
    JMP ADMIN_ENTRY


; MENU - Display menu and handle user choice


MENU:
    ;Check if admin mode is active
    CMP admin_mode,1
    JE ADMIN_MENU

    ; Regular user menu
    LEA DX,welcomeMsg
    MOV AH,9
    INT 21H

    LEA DX,menuMsg
    MOV AH,9
    INT 21H

    LEA DX,choiceMsg
    MOV AH,9
    INT 21H

    MOV AH,1
    INT 21H

    CMP AL,'1'
    JE START_GAME
    CMP AL,'2'
    JE EXIT
    CMP AL,'0'
    JE ADMIN_ENTRY

    JMP MENU


; ADMIN_MENU - Admin menu with settings access


ADMIN_MENU:
    LEA DX,adminMenuMsg
    MOV AH,9
    INT 21H

    MOV AH,1
    INT 21H

    CMP AL,'1'
    JE SETTINGS_MENU
    CMP AL,'2'
    JE START_GAME
    CMP AL,'3'
    JE RESET_ADMIN

    JMP ADMIN_MENU

RESET_ADMIN:
    MOV admin_mode,0
    JMP MENU


; SETTINGS_MENU - Settings menu with Read/Modify options


SETTINGS_MENU:
    LEA DX,viewmsg
    MOV AH,9
    INT 21H

    MOV AH,1
    INT 21H

    CMP AL,'1'
    JE VIEW_OPERATIONS
    CMP AL,'2'
    JE MODIFY_HP
    CMP AL,'3'
    JE ADMIN_MENU

    JMP SETTINGS_MENU


; START_GAME - Initialize and run all quiz levels


START_GAME:
    ; FEATURE: Game initialization - reset score and lives
    MOV score,0
    MOV AL,default_hp
    MOV lives,AL
    
    ; FEATURE: Sequential level progression (Easy -> Medium -> Hard)
    CALL RUN_EASY
    CMP lives,0
    JE FINAL_RESULT

    LEA DX,easyDone
    MOV AH,9
    INT 21H
    CALL SHOW_STATUS
    
    CALL RUN_MED
    CMP lives,0
    JE FINAL_RESULT

    LEA DX,medDone
    MOV AH,9
    INT 21H
    CALL SHOW_STATUS
    
    CALL RUN_HARD
    CMP lives,0
    JE FINAL_RESULT

    LEA DX,hardDone
    MOV AH,9
    INT 21H
    CALL SHOW_STATUS


; FINAL_RESULT - Evaluate score and display performance message


FINAL_RESULT:
    ; FEATURE: Score evaluation with 3 performance tiers
    MOV AX,score
    CMP AX,120
    JAE MSG_GOOD
    CMP AX,60
    JAE MSG_OK
    JMP MSG_BAD

MSG_GOOD:
    LEA DX,goodMsg
    JMP SHOW_MSG

MSG_OK:
    LEA DX,okMsg
    JMP SHOW_MSG

MSG_BAD:
    LEA DX,badMsg

SHOW_MSG:
    MOV AH,9
    INT 21H

    ; FEATURE: Play again option allows replay without restart
    LEA DX,playAgainMsg
    MOV AH,9
    INT 21H

    MOV AH,1
    INT 21H
    CMP AL,'y'
    JE START_GAME

    JMP EXIT

MAIN ENDP


; RUN_EASY PROCEDURE

; Loop through easy questions until all answered or lives = 0

RUN_EASY PROC
    MOV qIndex,0

EL:
    MOV AL,qIndex
    CMP AL,easyCount
    JAE ED

    CALL ASK_EASY

    CMP lives,0
    JE ED

    INC qIndex
    JMP EL

ED:
    RET

RUN_EASY ENDP


; RUN_MED PROCEDURE
; Loop through medium questions until all answered or lives = 0

RUN_MED PROC
    MOV qIndex,0

ML:
    MOV AL,qIndex
    CMP AL,medCount
    JAE MD

    CALL ASK_MED

    CMP lives,0
    JE MD

    INC qIndex
    JMP ML

MD:
    RET

RUN_MED ENDP


; RUN_HARD PROCEDURE

; Loop through hard questions until all answered or lives = 0

RUN_HARD PROC
    MOV qIndex,0

HL:
    MOV AL,qIndex
    CMP AL,hardCount
    JAE HD

    CALL ASK_HARD

    CMP lives,0
    JE HD

    INC qIndex
    JMP HL

HD:
    RET

RUN_HARD ENDP


; ASK_EASY PROCEDURE

; FEATURE: Easy level scoring - 10 points per correct answer

ASK_EASY PROC
    LEA SI,easyQuestions
    LEA DI,easyAnswers

    CALL ASK_COMMON
    JC EASY_CORRECT
    RET

EASY_CORRECT:
    ADD score,10
    RET

ASK_EASY ENDP


; ASK_MED PROCEDURE

; FEATURE: Medium level scoring - 15 points per correct answer

ASK_MED PROC
    LEA SI,medQuestions
    LEA DI,medAnswers

    CALL ASK_COMMON
    JC MED_CORRECT
    RET

MED_CORRECT:
    ADD score,15
    RET

ASK_MED ENDP


; ASK_HARD PROCEDURE

; FEATURE: Hard level scoring - 20 points per correct answer

ASK_HARD PROC
    LEA SI,hardQuestions
    LEA DI,hardAnswers

    CALL ASK_COMMON
    JC HARD_CORRECT
    RET

HARD_CORRECT:
    ADD score,20
    RET

ASK_HARD ENDP


; ASK_COMMON PROCEDURE

; Unified question handler for all difficulty levels


ASK_COMMON PROC
    ; Save all registers using PUSH
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    
    ; Calculate question address using index * 2 (word pointer)
    MOV BL,qIndex
    MOV BH,0
    MOV AX,BX
    MOV CX,2
    MUL CX
    MOV BX,AX
    ADD SI,BX
    MOV DX,[SI]

    MOV AH,9
    INT 21H
    
    ; Get user input into buffer
    LEA SI,userAns
    CALL INPUT_STRING
    
    ; Calculate answer address using same index
    POP DI
    PUSH DI
    MOV BL,qIndex
    MOV BH,0
    MOV AX,BX
    MOV CX,2
    MUL CX
    MOV BX,AX
    ADD DI,BX
    MOV DI,[DI]
    
    ; Compare user answer with correct answer
    LEA SI,userAns
    CALL COMPARE_STR
    JE SET_CARRY
    
    ; Wrong answer handling
    LEA DX,wrongMsg
    MOV AH,9
    INT 21H

    ; FEATURE: Lives system - decrease by 1 on wrong answer
    DEC lives
    CLC

    ; Restore all registers using POP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
